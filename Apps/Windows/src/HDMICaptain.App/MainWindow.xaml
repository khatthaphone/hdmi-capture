<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HDMICaptain.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HDMI Captain">
    <Grid Background="Black">
        <SwapChainPanel x:Name="VideoPanel" />
        <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="HDMI Captain" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText" Opacity="0.7" HorizontalAlignment="Center" />
        </StackPanel>
        <!-- XAML overlay: never part of SourceTexture, so never in screenshots or recordings. -->
        <TextBlock x:Name="StatsText" Visibility="Collapsed" Margin="12,40,12,12" FontFamily="Consolas" FontSize="12"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" Opacity="0.85" />
    </Grid>
</Window>
