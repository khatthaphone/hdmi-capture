<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsMinVersion)</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HDMICaptain.Media\HDMICaptain.Media.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- libjpeg-turbo from native/ (make win-deps), next to the tests so the MJPEG tests (task 090) can load it. -->
  <PropertyGroup>
    <VcpkgTriplet Condition="'$(Platform)' == 'ARM64'">arm64-windows</VcpkgTriplet>
    <VcpkgTriplet Condition="'$(VcpkgTriplet)' == ''">x64-windows</VcpkgTriplet>
    <TurboJpegDll>$(MSBuildThisFileDirectory)..\..\native\vcpkg_installed\$(VcpkgTriplet)\bin\turbojpeg.dll</TurboJpegDll>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(TurboJpegDll)')">
    <Content Include="$(TurboJpegDll)" Link="turbojpeg.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
