{
  "comment": "Windows: capture-endpoint formats vs the MS2109 audio quirk. The chip (USB 534D:2109) advertises 96 kHz mono 16-bit but sends 48 kHz stereo (same byte rate). Only that exact format is reinterpreted as 48000 Hz / 2 ch / 16 bit; everything else is left as reported. 'device' is informational: the rule looks at the format only.",
  "cases": [
    {"name": "MS2109 as reported", "device": {"vidPid": "534D:2109", "name": "USB Video"},
     "format": {"sampleRate": 96000, "channels": 1, "bitsPerSample": 16},
     "expect": {"reinterpret": true, "sampleRate": 48000, "channels": 2, "bitsPerSample": 16}},
    {"name": "MS2109 clone with another name, same format", "device": {"vidPid": "534D:2109", "name": "HDMI Capture"},
     "format": {"sampleRate": 96000, "channels": 1, "bitsPerSample": 16},
     "expect": {"reinterpret": true, "sampleRate": 48000, "channels": 2, "bitsPerSample": 16}},
    {"name": "MS2131 reports 48 kHz stereo", "device": {"vidPid": "345F:2131", "name": "UGREEN HDMI Capture"},
     "format": {"sampleRate": 48000, "channels": 2, "bitsPerSample": 16},
     "expect": {"reinterpret": false, "sampleRate": 48000, "channels": 2, "bitsPerSample": 16}},
    {"name": "UGREEN 25854 reports 48 kHz stereo", "device": {"vidPid": "1DE1:F105", "name": "UGREEN-25854"},
     "format": {"sampleRate": 48000, "channels": 2, "bitsPerSample": 16},
     "expect": {"reinterpret": false, "sampleRate": 48000, "channels": 2, "bitsPerSample": 16}},
    {"name": "44.1 kHz stereo untouched",
     "format": {"sampleRate": 44100, "channels": 2, "bitsPerSample": 16},
     "expect": {"reinterpret": false, "sampleRate": 44100, "channels": 2, "bitsPerSample": 16}},
    {"name": "48 kHz mono untouched",
     "format": {"sampleRate": 48000, "channels": 1, "bitsPerSample": 16},
     "expect": {"reinterpret": false, "sampleRate": 48000, "channels": 1, "bitsPerSample": 16}},
    {"name": "96 kHz stereo untouched",
     "format": {"sampleRate": 96000, "channels": 2, "bitsPerSample": 16},
     "expect": {"reinterpret": false, "sampleRate": 96000, "channels": 2, "bitsPerSample": 16}},
    {"name": "96 kHz mono 24-bit untouched",
     "format": {"sampleRate": 96000, "channels": 1, "bitsPerSample": 24},
     "expect": {"reinterpret": false, "sampleRate": 96000, "channels": 1, "bitsPerSample": 24}},
    {"name": "96 kHz mono 32-bit untouched",
     "format": {"sampleRate": 96000, "channels": 1, "bitsPerSample": 32},
     "expect": {"reinterpret": false, "sampleRate": 96000, "channels": 1, "bitsPerSample": 32}},
    {"name": "192 kHz mono untouched",
     "format": {"sampleRate": 192000, "channels": 1, "bitsPerSample": 16},
     "expect": {"reinterpret": false, "sampleRate": 192000, "channels": 1, "bitsPerSample": 16}},
    {"name": "48 kHz 5.1 untouched",
     "format": {"sampleRate": 48000, "channels": 6, "bitsPerSample": 16},
     "expect": {"reinterpret": false, "sampleRate": 48000, "channels": 6, "bitsPerSample": 16}}
  ]
}
